# Copy this file to `.env.local` and fill in your Supabase project values.
# Find these in: Supabase Dashboard → Project Settings → API.
#
# Both values are safe to expose to the browser (NEXT_PUBLIC_*). The anon key
# only grants what your Row Level Security policies allow.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# --- Invite-request email notifications (optional) ---
# Where notifications are sent (defaults to agroviobusiness@gmail.com).
NOTIFY_EMAIL=agroviobusiness@gmail.com
#
# Option A — Resend (recommended). Create a key at https://resend.com/api-keys
# RESEND_API_KEY=re_xxxxxxxx
# EMAIL_FROM=Agrovio <onboarding@resend.dev>   # or a verified domain sender
#
# Option B — Gmail SMTP. Needs 2FA + an App Password on the Gmail account.
# GMAIL_USER=agroviobusiness@gmail.com
# GMAIL_APP_PASSWORD=your-16-char-app-password
