# Copy this file to `.env.local` and fill in your values, then set the same
# variables in Vercel (Project Settings → Environment Variables) for prod + dev.
# NEVER commit `.env.local`. Anything prefixed NEXT_PUBLIC_ is sent to the
# browser; everything else is server-only — keep secrets out of NEXT_PUBLIC_*.

# --- Supabase (public, client-safe) ---
# Supabase Dashboard → Project Settings → API. The anon key only grants what
# your Row Level Security policies allow.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# --- Site URL (public) ---
# Canonical origin of the deployment. Used to build invite/reset links and as
# the metadataBase for OG/canonical URLs. In production this is the live URL.
NEXT_PUBLIC_SITE_URL=https://agrovio.io

# --- Supabase service role (SERVER-ONLY — never NEXT_PUBLIC, never in a client) ---
# Dashboard → Project Settings → API → service_role key. Bypasses RLS; the
# hidden admin portal and the rate limiter need it. Keep it secret.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Admin allowlist (SERVER-ONLY) ---
# Comma-separated emails allowed into /admin (everyone else gets a 404).
ADMIN_EMAILS=agroviobusiness@gmail.com

# --- Invite-request email notifications (optional, SERVER-ONLY) ---
# Where new-lead notifications are sent (defaults to agroviobusiness@gmail.com).
NOTIFY_EMAIL=agroviobusiness@gmail.com
#
# Option A — Resend (preferred). Create a key at https://resend.com/api-keys.
# Delivering to arbitrary recipients needs a verified domain; the onboarding
# sender only delivers to the account owner.
# RESEND_API_KEY=re_xxxxxxxx
# EMAIL_FROM=Agrovio <onboarding@resend.dev>
#
# Option B — Gmail SMTP fallback (used only if RESEND_API_KEY is unset).
# GMAIL_USER=you@gmail.com
# GMAIL_APP_PASSWORD=your-16-char-app-password
